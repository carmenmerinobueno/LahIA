# Copia este archivo como .env.local (en tu ordenador) o añade estas variables en Vercel → Settings → Environment Variables.
# Las encuentras en Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-publica-anon
# Dirección pública de la web (para los enlaces de los correos).
NEXT_PUBLIC_SITE_URL=https://somoslahia.com

# --- Solo servidor (NUNCA con NEXT_PUBLIC_) ---
# Supabase → Project Settings → API → service_role (secreta: solo en Vercel / .env.local)
SUPABASE_SERVICE_ROLE_KEY=
# Stripe → Developers → API keys (usa la sk_test_... mientras pruebas)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → tu endpoint https://TU-DOMINIO/api/pagos/webhook → Signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe → Product catalog → precio mensual y anual (price_...)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
